{
  "name": "shelf-image-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "npm run build && npm run start -- --hostname localhost --port 3000",
    "relay": "node --env-file-if-exists=infra/relay/.env.local --import tsx infra/relay/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md",
    "test": "vitest run",
    "golden:validate": "node --import tsx scripts/validate-golden-skus.ts",
    "probe": "node --env-file-if-exists=.env.local --import tsx scripts/probe-sources.ts",
    "test:e2e": "playwright test",
    "setup:model": "node scripts/setup-model.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "worker:build": "node scripts/build-cloud-worker.mjs",
    "postinstall": "node scripts/setup-onnx.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@neon/functions": "^0.11.0",
    "@vercel/functions": "^3.9.11",
    "cheerio": "^1.2.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "1.54.0",
    "next": "16.4.6",
    "onnxruntime-web": "1.30.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
