{
  "name": "shelf-image-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:model": "node scripts/setup-model.mjs",
    "search:setup": "node scripts/setup-search.mjs",
    "search:start": "docker compose --env-file infra/free-search/.env -f infra/free-search/compose.yml up -d",
    "search:stop": "docker compose --env-file infra/free-search/.env -f infra/free-search/compose.yml stop",
    "postinstall": "node scripts/setup-onnx.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cheerio": "^1.2.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
