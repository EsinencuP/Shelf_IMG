# Optional: self-hosted SearXNG (JSON enabled). Never use a random public instance.
SEARXNG_URL=
SEARXNG_API_TOKEN=
# Optional: Tavily Free/Researcher ONLY, with pay-as-you-go disabled.
TAVILY_API_KEY=
# Set true only after confirming Researcher and Pay-as-you-go OFF in the account dashboard.
# Required when /usage returns null (no configured paygo cap) rather than 0.
TAVILY_FREE_ACCOUNT_CONFIRMED=false
# Separate cap: basic search costs one credit; default 1, maximum 2 per SKU.
TAVILY_MAX_QUERIES=1
# Optional self-hosted Crawl4AI v0.9.4. No LLM keys required.
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
# Exact hosts only; no wildcard/subdomain match. Rendering disabled when empty.
CRAWL4AI_ALLOWED_HOSTS=linella.md,bucuria.md
# Optional: additional visual SKU verification; the app works without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Required before exposing search/proxy/verification APIs in production.
MVP_ACCESS_PASSWORD=
# Identify the application to Open Food Facts (use your URL or contact email).
OPENFOODFACTS_USER_AGENT=ShelfImageStudio/0.1 (local development)
# Maximum SearXNG query variants per SKU (1..6); Tavily has an additional cap above.
SEARCH_MAX_WEB_QUERIES=4
