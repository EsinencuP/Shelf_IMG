# Set a private password to enable API access in a production build.
MVP_ACCESS_PASSWORD=
OPENFOODFACTS_USER_AGENT=
BRAVE_SEARCH_API_KEY=
BRAVE_MAX_QUERIES=2
BRAVE_FREE_ONLY_CONFIRMED=false
BRAVE_FREE_ONLY_KEY_SHA256=
TAVILY_API_KEY=
TAVILY_FREE_ACCOUNT_CONFIRMED=false
TAVILY_MAX_QUERIES=1
SEARCH_MAX_WEB_QUERIES=4
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_NEGATIVE_CACHE_TTL_SECONDS=600
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Shared approved library and durable search queue (Neon Free).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-only Neon Function endpoint and generated origin secret.
SHELF_WORKER_URL=
SHELF_WORKER_SECRET=

# Optional home relay: base HTTPS URL (without /fetch); token matches infra/relay/.env.local.
RELAY_URL=
RELAY_TOKEN=
