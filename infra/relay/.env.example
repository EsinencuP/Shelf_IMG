# Copy to infra/relay/.env.local. Generate RELAY_TOKEN locally; never commit it.
RELAY_TOKEN=
# Exact hostnames only. Subdomains must be listed separately; no wildcards or URLs.
RELAY_ALLOWED_DOMAINS=metro.zakaz.md,api.metro.zakaz.md,bonus.zakaz.md,api.bonus.zakaz.md,linella.md,www.linella.md,bucuria.md,www.bucuria.md
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_MAX_BYTES=4000000
RELAY_TIMEOUT_MS=15000
